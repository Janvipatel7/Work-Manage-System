<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completed Tasks</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800">

    <div class="flex h-screen">

        <!-- Sidebar -->
        <aside class="w-64 bg-white shadow-lg flex flex-col fixed h-full">
            <div class="p-6 text-2xl font-bold border-b">Manager Panel</div>
            <nav class="flex-1 p-6 space-y-2 mt-4">
                <a href="/manager/dashboard" class="block px-4 py-2 rounded hover:bg-gray-200">Dashboard</a>
                <a href="/manager/work" class="block px-4 py-2 rounded hover:bg-gray-200">My Works</a>
                <a href="/manager/work/create" class="block px-4 py-2 rounded hover:bg-gray-200">Create Work</a>
                <a href="/manager/completed" class="block px-4 py-2 rounded hover:bg-gray-200 bg-green-100">Completed
                    Tasks</a>
                <form action="/auth/logout" method="GET" class="mt-6">
                    <button type="submit"
                        class="w-full bg-black text-white py-2 rounded hover:bg-gray-800">Logout</button>
                </form>
            </nav>
        </aside>

        <!-- Main content -->
        <main class="flex-1 ml-64 p-6 overflow-y-auto">
            <h1 class="text-3xl font-semibold mb-6">Completed Tasks</h1>

            <section>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% if(tasks.length> 0) { %>
                        <% tasks.forEach(task=> { %>
                            <div class="bg-green-100 p-4 rounded shadow">
                                <p class="font-medium text-lg">
                                    <%= task.title %>
                                </p>
                                <p class="text-sm text-gray-500 mt-1">
                                    Completed by: <%= task.assignedToMember ? task.assignedToMember.name : "Unknown" %>
                                </p>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p class="text-gray-500">No tasks completed yet.</p>
                                    <% } %>
                </div>

            </section>

        </main>

    </div>

</body>

</html>