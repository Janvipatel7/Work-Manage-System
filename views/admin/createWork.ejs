<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Work</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex">

  <main class="flex-1 p-6">
    <div class="max-w-lg bg-white p-6 rounded-lg shadow">
      <h1 class="text-xl font-bold mb-4">Create Work</h1>

      <form action="/admin/work/create" method="POST" class="space-y-4">
        <input type="text" name="title" placeholder="Work Title" required
          class="w-full border px-4 py-2 rounded" />

        <textarea name="description" placeholder="Description" required
          class="w-full border px-4 py-2 rounded h-28"></textarea>

        <button class="bg-black text-white px-6 py-2 rounded">
          Create
        </button>
      </form>
    </div>
  </main>
</body>
</html>
