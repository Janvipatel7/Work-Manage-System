<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Work</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex">

  <!-- SIDEBAR -->
  <aside class="w-64 bg-black text-white hidden md:flex flex-col">
    <div class="p-6 text-2xl font-bold border-b border-gray-700">
      Admin Panel
    </div>

    <nav class="flex-1 p-4 space-y-2 text-sm">
      <a href="/admin/dashboard" class="block px-4 py-2 rounded hover:bg-gray-800">
        Dashboard
      </a>
      <a href="/admin/work/create" class="block px-4 py-2 rounded hover:bg-gray-800">
        Create Work
      </a>
    </nav>

    <form action="/auth/logout" method="GET" class="p-4 border-t border-gray-700">
      <button class="w-full bg-white text-black py-2 rounded font-semibold">
        Logout
      </button>
    </form>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 p-6">

    <h1 class="text-2xl font-bold mb-6">Edit Work</h1>

    <div class="max-w-xl bg-white rounded-lg shadow p-6">

      <form
        action="/admin/work/edit/<%= work._id %>"
        method="POST"
        class="space-y-5">

        <!-- TITLE -->
        <div>
          <label class="block text-sm font-medium mb-1">Title</label>
          <input
            type="text"
            name="title"
            value="<%= work.title %>"
            required
            class="w-full border px-4 py-2 rounded focus:outline-none focus:ring-1 focus:ring-black"
          />
        </div>

        <!-- DESCRIPTION -->
        <div>
          <label class="block text-sm font-medium mb-1">Description</label>
          <textarea
            name="description"
            required
            class="w-full border px-4 py-2 rounded h-32 focus:outline-none focus:ring-1 focus:ring-black"
          ><%= work.description %></textarea>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex gap-3 pt-2">
          <a
            href="/admin/dashboard"
            class="px-4 py-2 border rounded hover:bg-gray-100 text-sm">
            Cancel
          </a>

          <button
            type="submit"
            class="px-6 py-2 bg-black text-white rounded text-sm">
            Update Work
          </button>
        </div>

      </form>
    </div>

  </main>
</body>
</html>
