<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>View Work</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex">

  <!-- SIDEBAR -->
  <aside class="w-64 bg-black text-white hidden md:flex flex-col">
    <div class="p-6 text-2xl font-bold border-b border-gray-700">
      Admin Panel
    </div>

    <nav class="flex-1 p-4 space-y-2 text-sm">
      <a href="/admin/dashboard" class="block px-4 py-2 rounded hover:bg-gray-800">
        Dashboard
      </a>
      <a href="/admin/work/create" class="block px-4 py-2 rounded hover:bg-gray-800">
        Create Work
      </a>
    </nav>

    <form action="/auth/logout" method="GET" class="p-4 border-t border-gray-700">
      <button class="w-full bg-white text-black py-2 rounded font-semibold">
        Logout
      </button>
    </form>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 p-6">

    <h1 class="text-2xl font-bold mb-6">Work Details</h1>

    <div class="max-w-xl bg-white rounded-lg shadow p-6 space-y-4">

      <div>
        <p class="text-sm text-gray-500">Title</p>
        <p class="font-semibold text-lg"><%= work.title %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Description</p>
        <p class="text-gray-700"><%= work.description %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Status</p>
        <span class="inline-block px-3 py-1 text-xs rounded bg-gray-200 text-gray-700">
          <%= work.status %>
        </span>
      </div>

      <% if (work.assignedToManager) { %>
        <div>
          <p class="text-sm text-gray-500">Assigned To</p>
          <p class="font-medium"><%= work.assignedToManager.name %></p>
        </div>
      <% } %>

      <!-- ACTION BUTTONS -->
      <div class="flex gap-3 pt-4">
        <a
          href="/admin/dashboard"
          class="px-4 py-2 border rounded hover:bg-gray-100 text-sm">
          Back
        </a>

        <a
          href="/admin/work/edit/<%= work._id %>"
          class="px-4 py-2 bg-black text-white rounded text-sm">
          Edit Work
        </a>
      </div>

    </div>
  </main>

</body>
</html>
