<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assign Work</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    select {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2210%22%20height%3D%227%22%20viewBox%3D%220%200%2010%207%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M0%200l5%207%205-7H0z%22%20fill%3D%22%23000%22/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      background-size: 0.65rem auto;
    }
  </style>
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">

  <main class="w-full max-w-md">
    <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-200">

      <h1 class="text-2xl font-bold text-black mb-4 text-center">Assign Work</h1>
      <p class="mb-6 font-semibold text-gray-700 text-center"><%= work.title %></p>

      <form method="POST" class="space-y-5">
        <div>
          <label class="block mb-2 text-gray-700 font-medium">Select Member</label>
          <select name="managerId" required 
                  class="w-full border border-gray-300 px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-black text-gray-900">
            <% managers.forEach(manager => { %>
              <option value="<%= manager._id %>"><%= manager.name %></option>
            <% }) %>
          </select>
        </div>

        <button type="submit" 
                class="w-full bg-black text-white py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors">
          Assign
        </button>
      </form>
    </div>
      <div class="p-3">
       <!-- Back Button -->
      <a href="/admin/dashboard" 
         class="inline-block mb-4 text-black border border-gray-400 px-4 py-2 rounded-lg hover:bg-gray-100 transition">
        &larr; Back to Dashboard
      </a>
   </div>
  </main>
</body>
</html>
