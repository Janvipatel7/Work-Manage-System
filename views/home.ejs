<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Work Management System</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex flex-col">

  <!-- Navbar -->
  <header class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-indigo-600">Work Management System</h1>
      <a href="/auth/login" class="bg-indigo-600 text-white px-5 py-2 rounded-lg hover:bg-indigo-700 transition">
        Login
      </a>
    </div>
  </header>

  <!-- Hero -->
  <main class="flex-1 flex items-center justify-center">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">

      <div>
        <h2 class="text-4xl font-bold text-gray-800 leading-tight">
          Smart <span class="text-indigo-600">Work Management</span> System
        </h2>
        <p class="mt-4 text-gray-600 text-lg">
          A complete role-based platform for Admin, Manager, and Members
          to manage work efficiently.
        </p>

        <div class="mt-6 flex gap-4">
          <a href="/auth/login"
            class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition">
            Get Started
          </a>
          <a href="#features"
            class="border border-indigo-600 text-indigo-600 px-6 py-3 rounded-lg hover:bg-indigo-50 transition">
            Learn More
          </a>
        </div>
      </div>

      <div class="hidden md:block">
        <img src="https://illustrations.popsy.co/gray/work-from-home.svg" class="w-full">
      </div>

    </div>
  </main>

  <!-- Features -->
  <section id="features" class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6">
      <h3 class="text-3xl font-bold text-center text-gray-800">Key Features</h3>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8">

        <div class="bg-indigo-50 p-6 rounded-xl shadow hover:shadow-md transition">
          <h4 class="text-xl font-semibold text-indigo-600">Admin Panel</h4>
          <p class="mt-2 text-gray-600">
            Manage users, assign managers, monitor system progress.
          </p>
        </div>

        <div class="bg-indigo-50 p-6 rounded-xl shadow hover:shadow-md transition">
          <h4 class="text-xl font-semibold text-indigo-600">Manager Dashboard</h4>
          <p class="mt-2 text-gray-600">
            Assign work, track progress, and review completed tasks.
          </p>
        </div>

        <div class="bg-indigo-50 p-6 rounded-xl shadow hover:shadow-md transition">
          <h4 class="text-xl font-semibold text-indigo-600">Member Workspace</h4>
          <p class="mt-2 text-gray-600">
            View tasks, update progress, and complete work efficiently.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-indigo-600 text-white py-4">
    <div class="text-center">
      © 2026 Work Management System | Developed by You 
    </div>
  </footer>

</body>
</html>
